# Generated/runtime output
logs/
runtime/logs/
runtime/generated/
release/
*.zip
*.sha256

# Python / Node / system caches
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
desktop.ini

# Local-only development folders
Compressed/
Deprecated/
ExtensionPresentation/
presentation/
devtools/

# Local audio-provider secrets
runtime/.env
.env

# Software Builder runtime state
runtime/workspace-state.json
.ms_snapshots/

# Per-machine runtime state that must NEVER ship in a release archive.
# engine-prefs.json records which engines THIS machine's user disabled; shipping
# one written on another OS both hides the engines (Unity/Godot/Blender arrived
# disabled) and defeats the Linux "Roblox Studio has no Linux build" auto-disable
# (bridge.py _load_engine_prefs only auto-disables when the file is absent).
# native_host.* and com.multiscript.bridge.json are generated by
# runtime/install_native_host.py and bake in an absolute interpreter path.
# NOTE: runtime/config.json is deliberately NOT listed here - it is the shipped
# default declaring the four engine MCP servers, not user state.
runtime/engine-prefs.json
runtime/native_host.bat
runtime/native_host.sh
runtime/com.multiscript.bridge.json
runtime/.venv/

# Publisher secrets and updater transactions (never commit)
*.pem
*.key
*.pfx
*.p12
.updates/
studio-data/
test-results/
node_modules/
.venv/
